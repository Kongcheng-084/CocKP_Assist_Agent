{
  "name": "keeper-prep-desktop",
  "productName": "KP备团台",
  "version": "0.13.0",
  "description": "本地 CoC KP 备团应用",
  "author": "Keeper Prep",
  "type": "module",
  "private": true,
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs core.test.cjs pdf-core.test.cjs",
    "pack": "electron-builder --win dir --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.keeperprep.desk",
    "productName": "KP备团台",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "ui/**",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "KP备团台-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "KP备团台-${version}-${arch}-免安装.exe"
    }
  }
}
